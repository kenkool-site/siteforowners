# Supabase
# Also used by the invitation-events module (owner/founder auth, RSVPs,
# notification reservation RPCs) — SUPABASE_SERVICE_ROLE_KEY is the only
# credential invitation server routes use to reach Postgres; it is never
# exposed to client components.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing (invitation owner sessions, event-scoped passcode
# sessions) — see src/lib/invitations/auth.ts. Must be at least 32 chars.
# Also signs private direct-upload tickets and derives the encrypted notification
# payload key. Back it up; rotation makes existing retry payloads unrecoverable.
SESSION_COOKIE_SECRET=

# Hashes client IPs for rate limiting (booking + invitation RSVP/passcode
# attempt limiters) — see src/lib/api-rate-limit.ts.
IP_HASH_PEPPER=

# Authorizes scheduled/cron endpoints (booking reminders, review requests,
# invitation media cleanup) — sent as `Bearer $CRON_SECRET`.
CRON_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# Plausible
PLAUSIBLE_API_KEY=
PLAUSIBLE_BASE_URL=https://plausible.io

# Resend (email)
# SiteForOwners product mail keeps EMAIL_FROM, display name included.
# InviteSpot guest and host mail reuses that same mailbox and only changes
# the display name, unless INVITATION_EMAIL_FROM_ADDRESS is set. Leave the
# override blank until invitespot.app is a verified Resend sending domain.
RESEND_API_KEY=
EMAIL_FROM=hello@siteforowners.com
# Optional bare address (or "Name <address>") for InviteSpot mail only.
# Blank uses the address in EMAIL_FROM, then hello@siteforowners.com.
INVITATION_EMAIL_FROM_ADDRESS=
# Display-name From address for tenant-branded SiteForOwners emails
# (bookings). Not used for InviteSpot mail.
EMAIL_FROM_ADDRESS=hello@siteforowners.com

# Twilio (SMS)
# Shared by booking texts, invitation owner notifications, and the optional
# private guest list. See src/lib/sms.ts. No separate guest-list sender.
# Missing credentials degrade gracefully (SMS sends are skipped, never thrown).
# US production texting needs A2P 10DLC registration on this same Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Guest-broadcast SMS cap when an event has no sms_broadcast_limit override.
# Positive integer, max 1000000. Blank uses 500. Host RSVP alert texts use
# invitation_events.sms_notification_limit and do not spend this budget.
INVITATION_SMS_BROADCAST_LIMIT=
# Guest-broadcast email cap when an event has no email_broadcast_limit override.
# Positive integer, max 1000000. Blank uses 1000. Host RSVP alert emails and
# guest confirmations use invitation_events.email_notification_limit and do
# not spend this budget. This does not raise Resend's plan quota.
INVITATION_EMAIL_BROADCAST_LIMIT=

# Cloudflare (DNS + domain registration)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# App
NEXT_PUBLIC_APP_URL=https://siteforowners.com
NEXT_PUBLIC_INVITESPOT_APP_URL=https://www.invitespot.app
ADMIN_EMAIL=

# InviteSpot Memories — R2 storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEMORIES=invitespot-memories

# InviteSpot Memories — Cloudflare Queues + internal service auth
CLOUDFLARE_QUEUES_API_TOKEN=
MEMORIES_DLQ_ID=
MEMORIES_INTERNAL_SECRET=

# InviteSpot Memories — AWS Rekognition moderation
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
