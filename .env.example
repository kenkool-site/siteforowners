# Supabase
# Also used by the invitation-events module (owner/founder auth, RSVPs,
# notification reservation RPCs) — SUPABASE_SERVICE_ROLE_KEY is the only
# credential invitation server routes use to reach Postgres; it is never
# exposed to client components.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing (invitation owner sessions, event-scoped passcode
# sessions) — see src/lib/invitations/auth.ts. Must be at least 32 chars.
# Also signs private direct-upload tickets and derives the encrypted notification
# payload key. Back it up; rotation makes existing retry payloads unrecoverable.
SESSION_COOKIE_SECRET=

# Hashes client IPs for rate limiting (booking + invitation RSVP/passcode
# attempt limiters) — see src/lib/api-rate-limit.ts.
IP_HASH_PEPPER=

# Authorizes scheduled/cron endpoints (booking reminders, review requests,
# invitation media cleanup) — sent as `Bearer $CRON_SECRET`.
CRON_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# Plausible
PLAUSIBLE_API_KEY=
PLAUSIBLE_BASE_URL=https://plausible.io

# Resend (email)
# Also used for invitation owner/guest notification emails (RSVP alerts,
# guest confirmations) — see src/lib/invitations/notifications.ts. No
# separate invitation-only email secret exists; it reuses these.
RESEND_API_KEY=
EMAIL_FROM=hello@siteforowners.com
# Display-name From address for tenant-branded emails (bookings, leads);
# invitation notifications currently send from EMAIL_FROM instead.
EMAIL_FROM_ADDRESS=hello@siteforowners.com

# Twilio (SMS)
# Also used for invitation owner SMS notifications — see
# src/lib/invitations/notifications.ts. No separate invitation-only SMS
# secret exists; it reuses these. Missing credentials degrade gracefully
# (SMS sends are skipped, never thrown) in both booking and invitation code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Cloudflare (DNS + domain registration)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# App
NEXT_PUBLIC_APP_URL=https://siteforowners.com
ADMIN_EMAIL=

# InviteSpot Memories — R2 storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEMORIES=invitespot-memories
